# Virtual environments
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# macOS
.DS_Store

# Editors
.idea/
.vscode/

# Captures are per-user runtime output, never commit real ones
captures/*
!captures/.gitkeep

# Downloaded model weights are large binaries fetched by scripts/download_model.sh
models/*.task
!models/.gitkeep

# Never commit secrets
.env
*.pem
*.key
